{
  "name": "phone-mcp",
  "version": "0.1.0",
  "description": "MCP server to control an Android phone with AI models over Tailscale",
  "main": "dist/index.js",
  "bin": {
    "phone-mcp": "dist/index.js"
  },
  "scripts": {
